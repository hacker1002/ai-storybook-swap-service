# Remix Swap Service — environment (copy to .env; NEVER commit .env)

# --- REQUIRED ---
# Postgres DSN. P3a: local Supabase DB (superuser `postgres`, bypasses RLS — authz
# is entirely app-layer). Deployment TODO: narrow DB role with grants per table.
APP_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Shared HS256 secret with the Admin App backend that MINTS editor-session tokens.
# Comma-separated list supported for rotation (old,new). DEV value only — MUST
# differ from prod and from PLAYER_TOKEN_SECRET / Supabase JWT secret.
REMIX_EDITOR_TOKEN_SECRET=dev-remix-editor-secret-change-me

# --- DB pool (optional) ---
APP_DB_POOL_MIN=2
APP_DB_POOL_MAX=10
APP_DB_STATEMENT_TIMEOUT_MS=15000
# Existing auth.users row used as background_jobs.user_id (NOT NULL FK). REQUIRED
# once jobs are inserted (P3b); optional at P3a.
REMIX_SWAP_SERVICE_USER_ID=

# --- Auth / request (optional) ---
EDITOR_TOKEN_LEEWAY_SECONDS=30
REQUEST_BODY_MAX_BYTES=20971520
CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=8100

# --- AI (optional at P3a, REQUIRED at P3b) ---
GOOGLE_CLOUD_PROJECT=
REPLICATE_API_TOKEN=
LANGCHAIN_API_KEY=
