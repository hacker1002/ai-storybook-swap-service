# Remix Swap Service — environment (copy to .env; NEVER commit .env)

# --- REQUIRED ---
# Postgres DSN. P3a: local Supabase DB (superuser `postgres`, bypasses RLS — authz
# is entirely app-layer). Deployment TODO: narrow DB role with grants per table.
APP_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# HS256 secret this service uses to MINT + verify editor-session access tokens
# (ADR-053 — the service owns minting). LOCAL-ONLY, never shared with the Admin App.
# Comma-separated list supported for rotation (old,new); mint uses the last entry.
REMIX_EDITOR_TOKEN_SECRET=dev-remix-editor-secret-change-me
# SHARED HS256 secret with the Admin App backend that signs the 60s handoff
# assertion (aud=remix-editor-handoff) exchanged at /api/editor/auth/exchange.
# The ONLY auth secret shared with App. Comma-list for rotation.
REMIX_EDITOR_HANDOFF_SECRET=dev-remix-handoff-secret-change-me

# --- DB pool (optional) ---
APP_DB_POOL_MIN=2
APP_DB_POOL_MAX=10
APP_DB_STATEMENT_TIMEOUT_MS=15000
# Existing auth.users row used as background_jobs.user_id (NOT NULL FK). REQUIRED
# once jobs are inserted (P3b); optional at P3a.
REMIX_SWAP_SERVICE_USER_ID=

# --- Auth / request (optional) ---
EDITOR_TOKEN_LEEWAY_SECONDS=30
# Access-token lifetime minted at exchange — flat 12h, no refresh (ADR-053).
EDITOR_ACCESS_TOKEN_TTL_SECONDS=43200
# S2S key for POST /internal/auth/revoke. EMPTY => fail-closed (revoke disabled,
# boot warning) so the service runs before Admin App P2 exists. Set in prod; MUST
# NOT equal any other secret and MUST NOT be exposed to the FE.
INTERNAL_API_KEY=
# Per-IP sliding-window cap on the public exchange endpoint (env override for NAT).
AUTH_EXCHANGE_RATE_LIMIT_PER_MIN=20
REQUEST_BODY_MAX_BYTES=20971520
CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=8100

# --- Storage Service (ADR-054 — env-presence switch) ---------------------------
# Set the 3 STORAGE_SERVICE_* vars → writes/signs/deletes go to the self-hosted
# storage service. Leave ALL THREE empty → legacy Supabase Storage (APP_STORAGE_*
# block below), the rollback path. HALF-configured (URL set, key/public base empty)
# = boot FAIL-FAST by design. Rollback = clear ALL THREE.
#
# ⚠️ LOOPBACK vs DOMAIN: STORAGE_SERVICE_URL is for WRITES → must be the LOOPBACK
# S2S address (127.0.0.1:8200). The public domain 403s every write (nginx proxies
# READ only). STORAGE_PUBLIC_BASE_URL is the READ base used to BUILD persisted URLs
# `{base}/files/{bucket}/{key}` → the public domain / nginx.
#
# STORAGE_SERVICE_URL=http://127.0.0.1:8200
# The `swap-service` entry from the storage service's STORAGE_API_KEYS. SECRET.
# STORAGE_SERVICE_API_KEY=
# Local dev: http://localhost:8200 (or your nginx). Prod: https://storage.<domain>.
# STORAGE_PUBLIC_BASE_URL=http://localhost:8200
# OPTIONAL loopback-nginx READ base (parity image-api, prod-proven there): when set,
# server-side re-fetches of persisted /files/ URLs (crop-sheet compose, audio chunks)
# are rewritten public→internal at fetch-time — skips the public-domain egress hop.
# Nothing rewritten is persisted. Empty = read via STORAGE_PUBLIC_BASE_URL (no rewrite).
# STORAGE_INTERNAL_READ_BASE_URL=http://127.0.0.1:8200

# --- Storage (LEGACY Supabase Storage REST via httpx — NO SDK; rollback path) ---
# Used ONLY when the STORAGE_SERVICE_* cluster above is empty.
# Base Supabase URL that also serves /storage/v1/... (local: http://127.0.0.1:54321).
# APP_STORAGE_URL=http://127.0.0.1:54321
# Service-role key for Storage writes. SECRET — never commit a real value.
# APP_STORAGE_SERVICE_KEY=
# Reuse the existing editor bucket (default storybook-assets — no new bucket).
# APP_STORAGE_BUCKET=storybook-assets
# Comma-separated SSRF allowlist (host or host:port) that bypasses the private-IP
# guard so the service can re-fetch its own uploads locally. When STORAGE_PUBLIC_BASE_URL
# is a loopback (dev), ADD the storage host here too (e.g. localhost:8200). Empty in prod.
# SSRF_ALLOWED_HOSTS=127.0.0.1:54321,localhost:8200

# --- AI (optional at P3a, REQUIRED at P3b) ---
GOOGLE_CLOUD_PROJECT=
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=

# VERTEX_AI_LOCATION=us-central1
# LangSmith tracing — dedicated project (separate from image-api).
# LANGCHAIN_PROJECT=remix-swap-service
# LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
