# Remix Swap Service — environment (copy to .env; NEVER commit .env)

# --- REQUIRED ---
# Postgres DSN. P3a: local Supabase DB (superuser `postgres`, bypasses RLS — authz
# is entirely app-layer). Deployment TODO: narrow DB role with grants per table.
APP_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Shared HS256 secret with the Admin App backend that MINTS editor-session tokens.
# Comma-separated list supported for rotation (old,new). DEV value only — MUST
# differ from prod and from PLAYER_TOKEN_SECRET / Supabase JWT secret.
REMIX_EDITOR_TOKEN_SECRET=dev-remix-editor-secret-change-me

# --- DB pool (optional) ---
APP_DB_POOL_MIN=2
APP_DB_POOL_MAX=10
APP_DB_STATEMENT_TIMEOUT_MS=15000
# Existing auth.users row used as background_jobs.user_id (NOT NULL FK). REQUIRED
# once jobs are inserted (P3b); optional at P3a.
REMIX_SWAP_SERVICE_USER_ID=

# --- Dev mint (spec 10 — DEV ONLY, stand-in for Admin App backend mint) ---
# Default OFF: /api/dev router not registered -> no mint surface. NEVER enable in
# production — the endpoint mints admin sessions gated only by DEV_MINT_KEY.
# Key is a real secret within a dev instance; do NOT reuse/derive other secrets.
# DEV_MINT_ENABLED=true
# DEV_MINT_KEY=dev-mint-key-change-me

# --- Auth / request (optional) ---
EDITOR_TOKEN_LEEWAY_SECONDS=30
REQUEST_BODY_MAX_BYTES=20971520
CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=8100

# --- Storage (Supabase Storage REST via httpx — NO SDK) ---
# Base Supabase URL that also serves /storage/v1/... (local: http://127.0.0.1:54321).
# APP_STORAGE_URL=http://127.0.0.1:54321
# Service-role key for Storage writes. SECRET — never commit a real value.
# APP_STORAGE_SERVICE_KEY=
# Reuse the existing editor bucket (default storybook-assets — no new bucket).
# APP_STORAGE_BUCKET=storybook-assets
# Comma-separated SSRF allowlist (host or host:port) that bypasses the private-IP
# guard so the service can re-fetch its own Storage uploads locally. Empty in prod.
# SSRF_ALLOWED_HOSTS=127.0.0.1:54321

# --- AI (optional at P3a, REQUIRED at P3b) ---
GOOGLE_CLOUD_PROJECT=
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=

# VERTEX_AI_LOCATION=us-central1
# LangSmith tracing — dedicated project (separate from image-api).
# LANGCHAIN_PROJECT=remix-swap-service
# LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
